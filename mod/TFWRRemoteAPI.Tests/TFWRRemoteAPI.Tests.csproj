<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game-independent tests for the plugin's pure code. Run with `dotnet run` from this directory.
       No NuGet packages, so it works offline and without the game installed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../TFWRRemoteAPI/MiniJson.cs" Link="MiniJson.cs" />
  </ItemGroup>

</Project>
